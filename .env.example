# RekaDijo — environment configuration
# Copy this file to .env (development) or .env.production (deployment)
# and fill in real values. Nothing here is a live secret.

# ── Database ────────────────────────────────────────────────────────────
# Local dev (Windows 10, PostgreSQL running locally or via WSL):
DATABASE_URL="postgresql://rekadijo_user:changeme@localhost:5432/rekadijo_dev?schema=public"

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3400"
NEXT_PUBLIC_APP_NAME="RekaDijo"
NEXT_PUBLIC_SUPPORT_EMAIL="techtursolutions@gmail.com"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+27671714777"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# ── File storage ────────────────────────────────────────────────────────
# "local" stores uploads under /public/uploads during development.
# Swap to "s3" (or equivalent) in production — see src/lib/storage.ts.
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Payments (NOT wired — placeholder only) ────────────────────────────
# Fill in once a real gateway (PayFast, Yoco, Stripe, Paystack, etc.) is
# chosen. Until then, the platform runs payments through a manual/mock
# provider so the quotation → payment → fulfillment flow can be tested.
# PAYMENT_PROVIDER="payfast"
# PAYMENT_MERCHANT_ID=""
# PAYMENT_MERCHANT_KEY=""
# PAYMENT_PASSPHRASE=""

# ── Maps / geocoding (NOT wired — placeholder only) ────────────────────
# The app currently stores lat/lng directly on Branch and BuyerAddress and
# does distance math in src/lib/geo.ts without an external API. Add a real
# geocoding/maps key here when ready (e.g. Google Maps, Mapbox).
# MAPS_PROVIDER="google"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace-with-google-maps-browser-key"

# ── Email / SMS (NOT wired — placeholder only) ─────────────────────────
# EMAIL_PROVIDER="resend"
# EMAIL_API_KEY=""
# EMAIL_FROM="no-reply@rekadijo.techtursolutions.com"
# SMS_PROVIDER="clickatell"
# SMS_API_KEY=""
